<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Disabled state (nothing to undo) - looks like pressed/washed out -->
    <item android:state_enabled="false">
        <layer-list>
            <item android:top="0dp" android:left="0dp" android:right="0dp" android:bottom="0dp">
                <shape android:shape="oval">
                    <solid android:color="#DDDDDD"/>
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Pressed state - flattened and washed out -->
    <item android:state_pressed="true">
        <layer-list>
            <!-- Main surface (flat and washed out when pressed) -->
            <item android:top="0dp" android:left="0dp" android:right="0dp" android:bottom="0dp">
                <shape android:shape="oval">
                    <solid android:color="#88CCFF"/>
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Normal state - 3D with radial gradient -->
    <item>
        <layer-list>
            <!-- Main surface with radial gradient (bright center, darker edges) -->
            <item android:top="0dp" android:left="0dp" android:right="0dp" android:bottom="0dp">
                <shape android:shape="oval">
                    <gradient
                        android:type="radial"
                        android:gradientRadius="80%"
                        android:centerColor="#00AAFF"
                        android:startColor="#00AAFF"
                        android:endColor="#000000"
                        />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>