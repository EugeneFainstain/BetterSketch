<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- History Slider -->
    <SeekBar
        android:id="@+id/seekProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="0"
        android:progress="0"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:splitTrack="false"/>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <!-- Stroke width slider -->
            <com.example.bettersketch.WidthSlider
                android:id="@+id/widthSlider"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:padding="8dp"/>

            <!-- Drawing surface -->
            <com.example.bettersketch.DrawingView
                android:id="@+id/drawingView"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="#FFFFFF" />

            <!-- Color slider -->
            <com.example.bettersketch.ColorSlider
                android:id="@+id/colorSlider"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:padding="8dp"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnSave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center"
            android:layout_marginTop="-2dp"
            android:text="Save"/>
    </FrameLayout>

    <!-- Loupe views -->
    <LinearLayout
        android:id="@+id/loupeContainer"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnUndo"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:textSize="12sp"
            android:layout_marginStart="-8dp"
            android:text="REW"/>

        <ImageView
            android:id="@+id/loupeView"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#E0E0E0"
            android:contentDescription="Selected endpoint"
            android:scaleType="centerInside" />

        <Button
            android:id="@+id/btnClear"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:textSize="12sp"
            android:text="DEL"/>

        <Button
            android:id="@+id/btnRedo"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:textSize="12sp"
            android:layout_marginEnd="-8dp"
            android:text="FF"/>
    </LinearLayout>

</LinearLayout>
