<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <!-- Stroke width slider -->
            <com.example.bettersketch.WidthSlider
                android:id="@+id/widthSlider"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:padding="8dp"/>

            <!-- Drawing surface -->

            <!-- Color slider -->
            <com.example.bettersketch.DrawingView
                android:id="@+id/drawingView"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="#FFFFFF" />

            <com.example.bettersketch.ColorSlider
                android:id="@+id/colorSlider"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:padding="8dp"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnShape"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:text="Shape?"
            android:visibility="gone"
            tools:visibility="visible" />

        <ImageButton
            android:id="@+id/btnDel"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="32dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/delete_button_background"
            android:contentDescription="@string/del"
            android:src="@drawable/outline_delete_forever_24"
            android:scaleType="fitCenter"
            android:padding="8dp"
            android:elevation="8dp" />

        <ImageButton
            android:id="@+id/btnUndoStrokeEdit"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="32dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/undo_button_background"
            android:contentDescription="@string/undo"
            android:src="@drawable/outline_undo_icon"
            android:scaleType="fitCenter"
            android:padding="8dp"
            android:elevation="3dp"
            android:visibility="gone"
            tools:visibility="visible" />

        <Button
            android:id="@+id/btnGroupStrokes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="24dp"
            android:backgroundTint="@android:color/holo_orange_light"
            android:text="@string/group"
            android:visibility="gone"
            tools:visibility="visible" />

        <Button
            android:id="@+id/btnUnGroupStrokes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="24dp"
            android:backgroundTint="#FF00FF"
            android:text="@string/ungroup"
            android:visibility="gone"
            tools:visibility="visible" />

        <Button
            android:id="@+id/btnDuplicateStroke"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="32dp"
            android:layout_marginBottom="24dp"
            android:backgroundTint="@color/dup_button_background"
            android:text="@string/dup"
            android:visibility="gone"
            tools:visibility="visible" />

    </FrameLayout>

    <com.example.bettersketch.SmoothingSlider
        android:id="@+id/smoothingSlider"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:padding="16dp"/>

</LinearLayout>